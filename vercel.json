{
  "framework": "tanstack-start",
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/icons/favicon.ico" },
    { "source": "/manifest.webmanifest", "destination": "/icons/manifest.json" },
    { "source": "/manifest.json", "destination": "/icons/manifest.json" },
    { "source": "/apple-touch-icon.png", "destination": "/icons/apple-icon-180x180.png" }
  ]
}
